# Nexa Capital lead notifications — local development template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Email and WhatsApp are independent: fill in whichever channel you want to use.

# --- Who receives the lead alerts -------------------------------------------------
# Recipient inbox for lead emails.
LEAD_EMAIL_TO=ATHARVAAYEWALE102@GMAIL.COM
# Recipient WhatsApp number in international format, digits only (country code first).
WHATSAPP_TO=919325324711

# --- Email delivery via Resend (https://resend.com) -------------------------------
# Create an API key in the Resend dashboard. Both values are required for email.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, e.g. leads@yourdomain.com.
RESEND_FROM=

# --- WhatsApp delivery via Meta WhatsApp Business Cloud API -----------------------
# All five values are required for WhatsApp. The approved template must contain
# 11 body placeholders in the order listed in README.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
META_GRAPH_VERSION=
